# ---------------------------------------------------------------------------
# AfterGlow 환경 변수
#
# 아래 값들은 전부 자리표시자(mock)다. 실제 키로 교체하기 전까지는
# NEXT_PUBLIC_DATA_SOURCE=mock 으로 두면 앱이 목데이터로 완전히 동작한다.
# ---------------------------------------------------------------------------

# 데이터 소스: mock | supabase
# supabase 로 바꾸면 아래 Supabase 키가 실제로 사용된다.
NEXT_PUBLIC_DATA_SOURCE=mock

# --- Supabase -------------------------------------------------------------
# https://app.supabase.com/project/_/settings/api 에서 발급
NEXT_PUBLIC_SUPABASE_URL=https://mock-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key-replace-me
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-replace-me

# --- Claude API (데일리 케어 카드 문장 생성) --------------------------------
# 없거나 mock 값이면 서버가 자동으로 로컬 생성기로 폴백한다.
ANTHROPIC_API_KEY=mock-anthropic-key-replace-me
ANTHROPIC_MODEL=claude-sonnet-5

# --- 외부 환경 데이터 (자외선/습도) -----------------------------------------
# 미설정 시 목데이터를 사용한다.
WEATHER_API_KEY=mock-weather-key-replace-me
